# Copy this file to .env and fill in your values. (.env is ignored by git.)

PORT=4000

# The frontend's URL, so the browser is allowed to call this API (CORS)
ALLOWED_ORIGIN=http://localhost:3000

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the SECRET key (sb_secret_... or the legacy "service_role" key).
# It must ONLY ever live in the backend — never in the frontend.
SUPABASE_SECRET_KEY=your-secret-key
